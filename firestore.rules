rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can access anything
    function isAuthenticated() {
      return request.auth != null;
    }

    // All operations data lives under operations/ops subcollections
    match /operations/ops/{subcollection}/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Allow operations/settings doc
    match /operations/settings {
      allow read, write: if isAuthenticated();
    }

    // School Setup: root-level per-school config, admin-write / any-authenticated-read.
    // PROPOSED ONLY — this file is known to be stale relative to what's actually live
    // for the teacher app's root `schools/**` tree (students, staffs, sheet entries,
    // etc. are already read/written there in production by rules not reflected here).
    // Reconcile against the real deployed rules before applying any of this.
    function isOpsAdmin() {
      return isAuthenticated() &&
        request.auth.token.email in ['sid@ops.clarified.in', 'angel@ops.clarified.in'];
    }
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isOpsAdmin();
    }
    match /schools/{schoolId}/{collection}/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOpsAdmin() &&
        collection in ['terms', 'grading_scales', 'subjects', 'classes', 'assessments',
                        'co_scholastic_activities', 'remark_categories', 'months',
                        'staffs', 'config',
                        // 'students' added for the Import feature's commit step
                        // (ops-admin only, same as every other School Setup write) —
                        // this collection is otherwise owned by the teacher app, so
                        // verify against the real deployed rules before applying,
                        // per the stale-rules warning above.
                        'students'];
    }
    // Survey assignment (functions/assign_survey) writes each recipient's
    // surveyInbox array and logs each run to
    // schools/{id}/survey_assignments/{runId}. Both happen through the Admin
    // SDK, which bypasses these rules entirely — nothing extra is granted
    // here on purpose. The dashboard only READS surveys and run history,
    // which the authenticated-read rule above already covers, and it never
    // writes a survey document at all.

    // Sheets Status (Phase 5) only toggles isFrozen / deletes empty stray docs
    // on existing smart_sheet_entries — never creates sheets (teacher app
    // find-or-creates those). Scoped separately since this collection is
    // otherwise owned by the teacher app, not School Setup config data.
    match /schools/{schoolId}/smart_sheet_entries/{docId} {
      allow read: if isAuthenticated();
      allow update, delete: if isOpsAdmin();
    }

    // Config Templates (Phase 6): top-level, not under any school, ops-tooling
    // only — not consumed by the teacher app, so read is admin-only too.
    match /config_templates/{templateId} {
      allow read, write: if isOpsAdmin();
    }

    // Import staging (School Material Import): top-level, not under any
    // school (a job can only belong to one school, recorded in school_id on
    // the doc itself). Nothing here is live data — commitImport is a
    // separate client-side write into schools/**, gated by isOpsAdmin above.
    match /staging_imports/{jobId} {
      allow read, write: if isOpsAdmin();
      match /rows/{rowId} {
        allow read, write: if isOpsAdmin();
      }
    }

    // Import alias map: global (NOT scoped to any school) subject/class name
    // mappings the cleaning stage learns over time — see functions/
    // generate_import/main.py's load_import_aliases and useImport.js's
    // resolveFieldValue. Same ops-admin gate as the rest of Import.
    match /import_aliases/{aliasId} {
      allow read, write: if isOpsAdmin();
    }

    // Education knowledge base overlay: global (NOT scoped to any school)
    // learned classifications — is this value a subject, a co-scholastic
    // area, a grade, a section? Seeded knowledge lives in code
    // (functions/generate_import/education_kb.json); only human-confirmed
    // additions land here, same self-learning pattern as import_aliases
    // above, and the same ops-admin gate. The import Cloud Function reads
    // this collection with the Admin SDK, which bypasses these rules.
    match /kb_entries/{entryId} {
      allow read, write: if isOpsAdmin();
    }

    // Setup wizard runs (New School / Reset School): top-level progress docs
    // written by the browser as each step completes, so closing the tab
    // mid-setup loses nothing. Not scoped under a school because the New
    // School wizard starts a run BEFORE the school doc exists. Ops-admin only
    // — a wizard run names schools and reset options and has no business
    // being readable by the teacher app.
    match /setup_wizard_runs/{runId} {
      allow read, write: if isOpsAdmin();
    }

    // Archives: pre-reset snapshots of a school's students, classes, sheet
    // entries and survey responses. Top-level and deliberately OUTSIDE
    // schools/** so the teacher and student apps cannot see them — an
    // archived roster surfacing in an app would look like live data.
    //
    // Written ONLY by functions/school_reset (Admin SDK, bypasses these
    // rules); the dashboard reads them to confirm an archive exists and to
    // show its verified counts. Client writes are therefore denied outright
    // rather than granted to ops-admins: nothing in the UI should be able to
    // edit a snapshot that reset_execute treats as proof.
    match /archives/{archiveId} {
      allow read: if isOpsAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isOpsAdmin();
        allow write: if false;
      }
    }

    // Reset run log: schools/{id}/resets/{runId}, written by reset_execute
    // through the Admin SDK. The dashboard reads it for run history. Read is
    // already covered by the schools/{schoolId}/{collection}/{docId} rule
    // above; 'resets' is deliberately NOT in that rule's writable-collection
    // list, so the client cannot forge or amend an audit entry.

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
